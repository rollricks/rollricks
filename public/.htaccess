# RollRicks — Hostinger (Apache / LiteSpeed) configuration
# Drop this file at the root of public_html alongside index.html

# ─────────────────────────────────────────────────────────
# Force HTTPS (Hostinger provides free Let's Encrypt SSL).
# Comment this block out if SSL isn't yet provisioned.
# ─────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ─────────────────────────────────────────────────────────
# Pretty URLs: /menu  →  /menu/index.html
# Next.js with trailingSlash:true emits /menu/index.html so this only
# helps when someone hits /menu without the trailing slash.
# ─────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # If the request maps to an existing file or directory, serve it as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Add trailing slash for clean URLs
  RewriteCond %{REQUEST_URI} !(/$|\.)
  RewriteRule (.*) %{REQUEST_URI}/ [R=301,L]
</IfModule>

# ─────────────────────────────────────────────────────────
# 404 page
# ─────────────────────────────────────────────────────────
ErrorDocument 404 /404.html

# ─────────────────────────────────────────────────────────
# Cache static assets aggressively. Next.js gives JS/CSS chunks
# content-hashed filenames, so a long max-age is safe — a new build
# produces new hashes and the browser fetches fresh files.
# ─────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Hashed chunks (immutable for the life of the deploy)
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Images + videos (30 days; re-encode under a new name to bust cache)
  <FilesMatch "\.(png|jpg|jpeg|gif|svg|ico|webp|avif|mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # HTML — short cache so deploys land fast
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=300, must-revalidate"
  </FilesMatch>

  # Basic security headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Force HTTPS for a year (only sent over HTTPS by browsers anyway).
  Header always set Strict-Transport-Security "max-age=31536000"

  # The site never needs camera / mic / location / payment APIs.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"

  # Content Security Policy — only our own files, Supabase (API +
  # realtime websocket) and the Google Maps embed may load. Blocks any
  # injected third-party script. 'unsafe-inline' is required for the
  # Next.js static-export bootstrap + theme script (no server to add
  # nonces). Keep in sync with scripts/csp-test-server.mjs.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-src https://www.google.com https://maps.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
</IfModule>

# ─────────────────────────────────────────────────────────
# Compression — LiteSpeed enables this by default but Apache may not.
# ─────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# ─────────────────────────────────────────────────────────
# MIME types (most are auto-set by Apache; these are the few that can
# be missing on shared hosting)
# ─────────────────────────────────────────────────────────
<IfModule mod_mime.c>
  AddType application/javascript .js
  AddType application/json .json
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType video/mp4 .mp4
  AddType video/webm .webm
</IfModule>
